{
  "name": "saga-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,leaf,platform \"vite\" \"tsx sim/leaf-sim.ts\" \"tsx server/platform.ts\"",
    "app": "vite",
    "leaf": "tsx sim/leaf-sim.ts",
    "platform": "tsx server/platform.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "tsx e2e/run.ts && tsx e2e/discover.ts && tsx e2e/nav.ts",
    "bench": "tsx bench/run.ts",
    "typecheck": "tsc --noEmit",
    "build:standalone": "vite build -c vite.standalone.config.ts && node -e \"require('fs').copyFileSync('dist-standalone/index.html','dist-standalone/saga-reader.html')\"",
    "publish:site": "node scripts/publish.mjs",
    "build:native": "vite build -c vite.standalone.config.ts --mode native",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node scripts/android-assets.mjs",
    "test:native": "npm run build:native && tsx e2e/native.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "foliate-js": "^1.0.1",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "busboy": "^1.6.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
